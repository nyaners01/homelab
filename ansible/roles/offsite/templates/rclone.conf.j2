[gdrive-backups]
type = drive
client_id = {{ rclone_gdrive_client_id }}
client_secret = {{ rclone_gdrive_client_secret }}
scope = drive.file
token = {{ rclone_gdrive_token }}
root_folder_id = {{ rclone_gdrive_root_folder_id }}

[gdrive-backups-encrypted]
type = crypt
remote = gdrive-backups:
password = {{ rclone_gdrive_crypted_pass }}
password2 = {{ rclone_gdrive_crypted_salt_pass }}
