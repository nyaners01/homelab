#!/bin/bash
# Управляется Ansible, роль offsite. Ручной запуск: sudo homelab-offsite

set -euo pipefail

send_dir(){
  local source_path=$1 dest_path=$2 retention_days=$3 retention_hours

  # Архив возрастом ровно N дней лежит на границе N×24h; вычитаем 6h, чтобы он удалялся, даже если бэкап отработал с опозданием
  retention_hours=$((retention_days * 24 - 6))

  rclone copy -v --stats-one-line \
    "$source_path" \
    "gdrive-backups-encrypted:$dest_path" || return 1
  rclone delete -v --stats-one-line \
    --min-age "${retention_hours}h" \
    "gdrive-backups-encrypted:$dest_path" \
    --drive-use-trash=false  || return 1
}

failed=0
{% for dir in offsite_source_dirs %}
send_dir {{ dir.path | quote }} {{ dir.dest_path | quote }} {{ dir.retention_days }} || failed=1
{% endfor %}

exit $failed
